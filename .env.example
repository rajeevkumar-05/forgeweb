# ForgeWeb environment template.
#
# Copy this file to `.env` and edit the values. `.env` is gitignored; this
# template is the only committed version and must never contain a real secret.
#
#   cp .env.example .env        # macOS/Linux
#   Copy-Item .env.example .env # Windows PowerShell
#
# Precedence: real environment variables > .env > built-in defaults.
# Every setting is optional. With no configuration at all, ForgeWeb tries a
# local Ollama instance and falls back to deterministic template generation.
#
# Each setting accepts a canonical FORGEWEB_LLM_* name and a shorter LLM_*
# alias. When both are set, FORGEWEB_LLM_* wins.

# --- Provider selection -------------------------------------------------------

# "ollama" (default) or "openai-compatible".
# Friendly aliases resolving to openai-compatible: openai, openrouter, groq,
# together, agentrouter, lmstudio, vllm, mistral, deepseek, fireworks.
LLM_PROVIDER=ollama

# Model identifier. Defaults: "qwen2.5-coder:7b-instruct" for ollama,
# "gpt-4o-mini" for openai-compatible.
LLM_MODEL=qwen2.5-coder:7b-instruct

# API base URL. Defaults: "http://127.0.0.1:11434" for ollama,
# "http://127.0.0.1:1234/v1" (LM Studio) for openai-compatible.
LLM_BASE_URL=http://127.0.0.1:11434

# API key for hosted OpenAI-compatible gateways. Leave empty for local Ollama
# and LM Studio. Never commit a real key — keep it in `.env` only.
LLM_API_KEY=

# --- Generation tuning --------------------------------------------------------

# Sampling temperature, 0.0–2.0. Low values keep generated code deterministic.
LLM_TEMPERATURE=0.1

# Maximum output tokens per request (minimum 256).
LLM_MAX_TOKENS=4096

# Per-request timeout in milliseconds (minimum 5000). Small local models on CPU
# can need several minutes for a full frontend, so keep this generous.
LLM_TIMEOUT_MS=120000

# Set to "false" to disable AI generation entirely and use only the
# deterministic template path. Useful for offline work and for tests.
LLM_ENABLED=true

# --- Control plane ------------------------------------------------------------

# Port for the standalone API (`pnpm dev:api` / `pnpm start:api`).
# FORGEWEB_API_PORT=8787

# Directory for the local ForgeWeb JSON store.
# FORGEWEB_DATA_DIR=.forgeweb-data

# Alternate environment file to load instead of `.env`.
# FORGEWEB_ENV_FILE=.env.local

# --- Verified generation activation -----------------------------------------

# Keep the completed PostgreSQL-safe generation pipeline opt-in. The token is
# exchanged for a short-lived HttpOnly session and is never sent to generated
# applications. Use a random value of at least 32 characters in your local
# `.env`; never put the real value in this template.
# FORGEWEB_SAFE_GENERATION_ENABLED=false
# FORGEWEB_SAFE_GENERATION_TOKEN=
# FORGEWEB_SAFE_GENERATION_OWNER_ID=
# FORGEWEB_SAFE_GENERATION_SUBJECT_ID=

# --- Hosted provider examples (do not commit real values) ---------------------
#
# OpenRouter:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct
# LLM_API_KEY=sk-your-key-here
#
# TokenRouter (GLM 5.3 Free):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.tokenrouter.com/v1
# LLM_MODEL=z-ai/glm-5.3-free
# LLM_API_KEY=your-tokenrouter-key
#   — or set TOKENROUTER_API_KEY in the environment; it is accepted as an alias.
